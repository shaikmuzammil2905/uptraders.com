# Environment Variables Example
# Copy this file to .env and fill in your actual values.
# NEVER commit the actual .env file.

# Backend API URL (local development)
VITE_API_URL=http://localhost:5000/api

# Backend API URL (production - points to your deployed backend)
VITE_BACKEND_URL=https://your-backend-url.vercel.app/api

# Stripe (use test keys for development)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_key_here

# Google Maps API Key
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Razorpay (use test keys for development)
VITE_RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_here

# Google OAuth Client ID
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
